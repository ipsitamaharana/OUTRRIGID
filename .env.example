# ==============================================================================
# OUTRRIGID Full-Stack Environment Variables Template (.env.example)
# DO NOT put real passwords or connection strings here.
# Copy this file to '.env' and fill in your actual credentials.
# '.env' is listed in .gitignore and will never be committed to Git.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/outrrigid?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret Key (Minimum 32 characters)
# Used to sign HTTP-only session cookies
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_32chars

# JWT Cookie Expiration (e.g. 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# CSRF Protection Secret (Random string for double-submit cookie verification)
CSRF_SECRET=your_csrf_secret_key_change_this_in_production

